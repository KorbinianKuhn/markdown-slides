{
  // Shared settings. TypeScript only type-checks; esbuild builds.
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
