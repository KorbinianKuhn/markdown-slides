{
  "name": "@korbiniankuhn/markdown-slides",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Create beautiful HDM branded HTML slides from markdown files",
  "keywords": [
    "markdown",
    "slides",
    "presentation",
    "cli",
    "html",
    "hdm"
  ],
  "homepage": "https://github.com/KorbinianKuhn/markdown-slides#readme",
  "bugs": {
    "url": "https://github.com/KorbinianKuhn/markdown-slides/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KorbinianKuhn/markdown-slides.git"
  },
  "license": "MIT",
  "author": "Korbinian Kuhn",
  "bin": {
    "md2slides": "./cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mts",
    "examples": "node dist/cli.js -i . -o public --allowed-files README.md && node dist/cli.js -i examples/custom-theme -o examples/custom-theme/public -l en --institution \"Custom Institution\" && if [ -d examples/mwa ]; then node dist/cli.js -i examples/mwa -o examples/mwa/public -l en; fi",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/cli && tsc -p packages/app && tsc",
    "test": "playwright test",
    "test:docker": "sh tests/docker.sh"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": false
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/inconsolata": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.5",
    "argparse": "^3.0.4",
    "esbuild": "^0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "handlebars": "^4.7.10",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1",
    "mathjax": "~4.1.3",
    "mermaid": "~12.3.0",
    "prettier": "3.10.1",
    "sass": "^1.108.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
